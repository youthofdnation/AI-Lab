# Separate RIAN Commander staging service, never the legacy production Relay.
FROM node:22-alpine
WORKDIR /srv/rian-staging
ENV NODE_ENV=production
COPY tenant-artifact-core.mjs tenant-artifact-http.mjs tenant-job-policy.mjs ./
COPY staging-sqlite.mjs durable-tenant-artifacts.mjs durable-tenant-jobs.mjs ./
COPY outlook-ops-scope.mjs long-job-kinds.mjs mail-review-scope.mjs read-policy-scope.mjs read-policy-store.mjs durable-long-jobs.mjs long-job-http.mjs staging-server.mjs ./
COPY staging-entry.mjs ./
EXPOSE 3000
CMD ["node","staging-entry.mjs"]
